# ═══════════════════════════════════════════════════
# KALAN - CONFIGURATION EXEMPLE
# ═══════════════════════════════════════════════════
# Copier ce fichier en .env et remplir avec TES valeurs

# ─── SUPABASE (backend) ───
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=votre-cle-anon-ici
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-ici

# ─── APP FLUTTER ───
# Ces clés sont les mêmes que Supabase ci-dessus
# Elles vont dans kalan_app/.env (copie locale)

# ─── IA (OPTIONNEL - CLOUD) ───
GEMINI_API_KEY=votre-cle-gemini-ici

# ─── NOTIFICATIONS (OPTIONNEL) ───
FCM_SERVER_KEY=votre-cle-fcm-ici
